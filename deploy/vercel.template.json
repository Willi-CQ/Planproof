{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/reader.py": {
      "maxDuration": 300,
      "includeFiles": "{backend,tools/free_agent_room_qa,models/sheet-doors-v1,planproof_runtime}/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api(/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
